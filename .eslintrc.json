{
	"env": {
	  "node": true,
	  "es2021": true
	},
	"extends": [
	  "eslint:recommended",
	  "prettier",
	  "plugin:prettier/recommended"
	],
	"parserOptions": {
	  "ecmaVersion": "latest",
	  "sourceType": "module"
	},
	"plugins": ["prettier"],
	"rules": {
	  "prettier/prettier": "error",
	  "no-console": "warn",
	  "no-unused-vars": "warn",
	  "semi": ["error", "always"]
	}
  }
  